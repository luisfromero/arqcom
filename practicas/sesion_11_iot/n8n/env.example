# n8n environment (override via docker-compose env_file)
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Madrid

# Optional: set if exposing webhooks externally
# WEBHOOK_URL=http://localhost:5678/

# OpenAI (opcional para nodo de IA)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# MQTT auth (si se usa auth en Mosquitto)
# MQTT_USERNAME=
# MQTT_PASSWORD=

