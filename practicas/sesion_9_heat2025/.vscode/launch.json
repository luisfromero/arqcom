{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(GDB) Compilar y Depurar Archivo",
            "type": "cppdbg",
            "request": "launch",
            // La ruta al programa ejecutable. VS Code la necesita para iniciar el depurador.
            // ${fileDirname} es la carpeta del archivo que tienes abierto.
            // ${fileBasenameNoExtension} es el nombre del archivo sin la extensión.
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Habilitar formato elegante para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // Antes de depurar, ejecuta la tarea "C/C++: gcc build active file".
            "preLaunchTask": "C/C++: gcc build active file"
        }
    ]
}
